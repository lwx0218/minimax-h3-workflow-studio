# Application: keep runtime state inside this repository.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=./var
DATABASE_URL=sqlite:///./var/db/app.sqlite3

# Use mock until the local H3 feasibility spike succeeds.
H3_BACKEND=mock
H3_MODEL_PATH=
H3_FL2VA_URL=http://127.0.0.1:30010
H3_REF2VA_URL=http://127.0.0.1:30011
H3_MAX_CONCURRENCY=1

# Keep application/runtime caches out of the user home directory.
HF_HOME=./var/cache/huggingface
TORCH_HOME=./var/cache/torch
XDG_CACHE_HOME=./var/cache/xdg
TMPDIR=./var/tmp

# Large JSON snapshots and completed logs may be compressed.
ARTIFACT_COMPRESSION=gzip
