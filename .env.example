# Copy to .env.local (ignored) and load it before running scripts:
#   set -a; . ./.env.local; set +a

# External MiniMax-H3 model root; large weights never enter Git.
H3_MODEL_ROOT=/path/to/MiniMax-H3

# Studio bind address. 127.0.0.1 = this machine only; 0.0.0.0 = whole LAN.
# There is no authentication, so only expose it on a trusted network.
H3_STUDIO_HOST=127.0.0.1
H3_STUDIO_PORT=30210

# Where ComfyUI + venv live after scripts/prepare_runtime.py (ignored).
H3_RUNTIME_ROOT=./var/runtime

# Run records and uploads (ignored).
H3_STUDIO_DATA=./var/h3-studio

# Worker pool definition. Workers bind worker_host from this file (default loopback)
# and are reached only through the Studio.
H3_WORKER_POOL_CONFIG=./config/worker-pool.json

# Keep caches out of the home directory.
HF_HOME=./var/cache/huggingface
TORCH_HOME=./var/cache/torch
XDG_CACHE_HOME=./var/cache/xdg
TMPDIR=./var/tmp
