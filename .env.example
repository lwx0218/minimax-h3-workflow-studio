# R4 H3 Studio product entry (local single-user defaults)
H3_STUDIO_HOST=127.0.0.1
H3_STUDIO_PORT=30210
H3_STUDIO_DATA=./var/h3-studio

# Worker Pool / Advanced Canvas defaults. R4 reads config/worker-pool.json
# for worker-gpu0..worker-gpu4, ports 30211..30215 and safe_concurrent_runs=2.
H3_WORKER_POOL_CONFIG=./config/worker-pool.json
H3_WORKER_HOST=127.0.0.1
H3_WORKER_PORT=30211
H3_WORKER_URL=http://127.0.0.1:30211
H3_WORKER_GPU=0

# External model assets; keep large weights outside Git.
H3_MODEL_ROOT=${EXTERNAL_MINIMAX_H3_MODEL_ROOT}

# Keep application/runtime caches out of the user home directory.
HF_HOME=./var/cache/huggingface
TORCH_HOME=./var/cache/torch
XDG_CACHE_HOME=./var/cache/xdg
TMPDIR=./var/tmp
