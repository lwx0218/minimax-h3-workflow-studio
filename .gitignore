# Machine-local configuration and secrets
.env
.env.*
!.env.example

# Python
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Project runtime state: generated media, caches, logs and DBs stay local only.
# Keep only its documentation in Git.
/var/*
!/var/README.md

# Model weights and media must never enter Git
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf
*.mp4
*.sqlite3
*.log

# IDE and OS noise
.vscode/
.idea/
.DS_Store
